# OpenRouter API Key for Hermes LLM Provider (Required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Apify Token for Data Scraping (Optional - Falls back to direct Binance API if empty)
APIFY_TOKEN=your_apify_token_here

# Risk Management Settings
BANKROLL=1000.0
KELLY_FRACTION=0.5

# Execution Settings
TRADING_LOOP_INTERVAL=15

# OpenRouter Free LLM Model selection
DEFAULT_MODEL=meta-llama/llama-3-8b-instruct:free
